{
  "appId": "com.processdraw.desktop",
  "copyright": "Copyright 2026 ProcessDraw. Based on draw.io, copyright 2005-2026 draw.io Ltd and draw.io AG",
  "asar": true,
  "extraFiles": [
    { "from": "LICENSE", "to": "LICENSE.ProcessDraw.txt" },
    { "from": "NOTICE", "to": "NOTICE.ProcessDraw.txt" },
    { "from": "drawio/LICENSE", "to": "LICENSE.drawio.txt" }
  ],
  "files": [
    "**/*",
    "!**/WEB-INF{,/**}",
    "!drawio/src/main/webapp/stencils/**/*.xml",
    "!drawio/src/main/webapp/shapes{,/**}",
    "!drawio/src/main/webapp/js/diagramly{,/**}",
    "drawio/src/main/webapp/js/diagramly/{ElectronApp,DesktopLibrary}.js",
    "!drawio/src/main/webapp/js/grapheditor{,/**}",
    "!drawio/src/main/webapp/mxgraph/src{,/**}",
    "!drawio/src/main/webapp/mxgraph/mxClient.js",
    "!node_modules/@cantoo/pdf-lib/{cjs,dist,src,ts3.4}{,/**}",
    "!**/*.map",
    "!mcp{,/**}",
    "!tools{,/**}"
  ],
  "artifactName": "${productName}-${arch}-${version}.${ext}",
  "directories": {
    "output": "./dist/"
  },
  "npmRebuild": false,
  "publish": {
      "provider": "github"
  },
  "win": {
    "target": [
      {
          "target": "appx",
          "arch": [
            "x64"
          ]
      }
    ]
  },
  "appx": {
    "displayName": "ProcessDraw",
    "publisherDisplayName": "ProcessDraw",
    "identityName": "ProcessDraw",
    "publisher": "CN=ProcessDraw",
    "minVersion": "10.0.17763.0",
    "maxVersionTested": "10.0.17763.0"
  },
  "afterPack": "build/fuses.mjs",
  "fileAssociations": [
	  {
	  	"ext": "drawio",
	  	"name": "Diagram (.drawio)",
	  	"description": "Diagram (.drawio)",
	  	"mimeType": "application/vnd.jgraph.mxfile",
	  	"role": "Editor"
	  },
	  {
	  	"ext": "vsdx",
	  	"name": "VSDX Document",
	  	"description": "VSDX Document",
	  	"mimeType": "application/vnd.visio",
	  	"role": "Editor"
	  },
	  {
	  	"ext": ["mmd", "mermaid"],
	  	"name": "Mermaid Diagram",
	  	"description": "Mermaid Diagram",
	  	"mimeType": "text/vnd.mermaid",
	  	"role": "Editor"
	  }
  ]
}
